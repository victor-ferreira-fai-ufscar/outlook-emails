# ---------------------------------------------------------------------------
# Microsoft Graph / Azure AD
# Obtenha em: https://portal.azure.com -> Azure Entra ID -> App registrations
# ---------------------------------------------------------------------------
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret
MS_TENANT_ID=common

# Redirect URI: deve coincidir exatamente com o registrado no Azure
# Local:    http://localhost:8000/auth/callback
# Producao: https://seu-app.onrender.com/auth/callback
MS_REDIRECT_URI=http://localhost:8000/auth/callback

# ---------------------------------------------------------------------------
# Bot / webhook (Teams ou outro canal)
# ---------------------------------------------------------------------------
BOT_LOGIN_URL=http://localhost:8000/auth/login

# Se true, o webhook /bot/messages exige Authorization: Bearer <BOT_BEARER_TOKEN>
BOT_REQUIRE_AUTH=false
BOT_BEARER_TOKEN=change-me-in-production
BOT_ALLOWED_CHANNEL=msteams

# ---------------------------------------------------------------------------
# Supabase (opcional)
# Quando configurado, sessoes e perfis sao sincronizados em nuvem.
# Sem isso, tudo fica apenas local em sessions/
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# ---------------------------------------------------------------------------
# WhatsApp via Evolution API
# Documentacao: https://doc.evolution-api.com/
# Envio de mensagem: POST /message/sendText/{instance}
# Webhook inbound: configure a Evolution para apontar eventos messages.upsert
# para POST /whatsapp/webhook neste backend.
# ---------------------------------------------------------------------------
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key
EVOLUTION_INSTANCE=outlook-emails

# Numero com DDI + DDD, sem espacos, sem simbolo +
# Exemplo: 5511987654321
EVOLUTION_DEFAULT_NUMBER=5511999999999

# Timeout HTTP de integracao com a Evolution API
EVOLUTION_TIMEOUT_SECONDS=20

# Segredo opcional para validar o webhook inbound.
# Se definido, envie no header x-evolution-secret ou apikey do webhook.
EVOLUTION_WEBHOOK_SECRET=

# Permite processar comandos enviados pelo proprio numero conectado na instancia.
# Recomendado apenas para desenvolvimento/testes locais.
WHATSAPP_ALLOW_FROM_ME=false

# ---------------------------------------------------------------------------
# Automacao do resumo diario
# ---------------------------------------------------------------------------

# Se true, o endpoint POST /notifications/daily-summary exige
# Authorization: Bearer <NOTIFICATIONS_AUTOMATION_TOKEN>
NOTIFICATIONS_REQUIRE_AUTH=true

# Segredo que voce define livremente (gere com: python3 -c "import secrets; print(secrets.token_hex(32))")
# Use o mesmo valor como secret NOTIFICATIONS_AUTOMATION_TOKEN no GitHub Actions
NOTIFICATIONS_AUTOMATION_TOKEN=change-me

# Janela de tempo dos emails (horas). Padrao: 24
SUMMARY_WINDOW_HOURS=24

# Maximo de emails buscados da API do Graph. Padrao: 20
SUMMARY_MAX_ITEMS=20

# Maximo de emails exibidos no resumo enviado ao WhatsApp. Padrao: 10
SUMMARY_TOP_N=10

# Remetentes prioritarios (CSV de emails). Emails desses remetentes sao sempre "urgente".
# Exemplo: gerente@empresa.com,ceo@empresa.com
SUMMARY_PRIORITY_SENDERS=

# ---------------------------------------------------------------------------
# Seguranca da sessao
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SESSION_SECRET_KEY=change-this-in-production